{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openaudit.dev/schemas/audit_event_v0.1.json",
  "title": "OpenAudit Event",
  "description": "Audit event for AI agent actions. Approval-First, Verifiable Evidence, Offline-First, Risk-Native.",
  "type": "object",
  "required": [
    "event_id", "timestamp", "agent_id", "session_id",
    "action_type", "action_details",
    "risk_score", "risk_level",
    "approval_state", "approval_reason",
    "execution_status", "evidence_hash"
  ],
  "properties": {
    "event_id": { "type": "string", "format": "uuid" },
    "trace_id": { "type": "string" },
    "parent_event_id": { "type": ["string", "null"], "format": "uuid" },
    "root_event_id": { "type": "string", "format": "uuid" },
    "timestamp": { "type": "string", "format": "date-time" },
    "agent_id": { "type": "string" },
    "session_id": { "type": "string" },
    "action_type": {
      "type": "string",
      "enum": ["tool_call", "data_access", "approval_request", "approval_response", "blocked_action"]
    },
    "action_details": { "type": "object" },
    "risk_score": { "type": "number", "minimum": 0, "maximum": 1 },
    "risk_level": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
    "approval_state": { "type": "string", "enum": ["pending", "approved", "blocked", "escalated"] },
    "approval_reason": { "type": "string" },
    "approval_actor": { "type": ["string", "null"] },
    "execution_status": { "type": "string", "enum": ["pending", "success", "failed", "skipped"] },
    "evidence_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "evidence_location": { "type": "string" }
  },
  "additionalProperties": false
}
